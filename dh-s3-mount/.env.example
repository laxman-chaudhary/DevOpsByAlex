# Copy to .env for a single-server deployment, or provision securely as
# /etc/dh-s3-mount/config.env (root:root, mode 600).
# Do not commit real credentials.
S3_ENDPOINT="https://s3-np1.datahub.com.np"
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY="REPLACE_ME"
S3_SECRET_KEY="REPLACE_ME"
S3_REGION=""
S3_FORCE_PATH_STYLE="true"
RCLONE_REMOTE="s3remote"
MOUNT_PATH="/mnt/s3-storage"
SERVICE_NAME="dh-s3-mount"
